<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <!-- <meta name="apple-mobile-web-app-capable" content="yes"> -->
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>


    <!-- OGP -->
    <meta property="og:title" content="<%= content_for?(:og_title) ? yield(:og_title) : 'りんって書ける？' %>" />
    <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : 'あなたのアプリの紹介文' %>" />
    <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image) : image_url('top_page_logo.jpg') %>" />
    <meta property="og:url" content="<%= request.original_url %>" />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <%= yield %>
  </body>
</html>
