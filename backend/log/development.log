  [1m[36mTRANSACTION (0.1ms)[0m  [1m[35mBEGIN[0m
  [1m[36mQuestion Create (1.3ms)[0m  [1m[32mINSERT INTO `questions` (`content`, `explanation`, `created_at`, `updated_at`) VALUES ('幼名では通称「麟太郎」という名前で呼ばれていた歴史上の人物は次のうち誰か', '幼名および通称は麟太郎（りんたろう）。諱は義邦（よしくに）。明治維新後は安芳（やすよし）と改名。海舟は号で、佐久間象山直筆の書「海舟書屋」からとったもの。', '2025-09-04 05:17:33.373397', '2025-09-04 05:17:33.373397')[0m
  [1m[36mTRANSACTION (1.2ms)[0m  [1m[35mCOMMIT[0m
  [1m[36mQuestion Load (0.4ms)[0m  [1m[34mSELECT `questions`.* FROM `questions` WHERE `questions`.`content` = '問題の作者がこの名前で実際に困ったこととして、当てはまらないものは次のうちどれか' LIMIT 1[0m
  [1m[36mTRANSACTION (0.1ms)[0m  [1m[35mBEGIN[0m
  [1m[36mQuestion Create (1.2ms)[0m  [1m[32mINSERT INTO `questions` (`content`, `explanation`, `created_at`, `updated_at`) VALUES ('問題の作者がこの名前で実際に困ったこととして、当てはまらないものは次のうちどれか', '習字は名前のせいで5回は書き直してた。', '2025-09-04 05:17:33.396558', '2025-09-04 05:17:33.396558')[0m
  [1m[36mTRANSACTION (0.8ms)[0m  [1m[35mCOMMIT[0m
  [1m[36mQuestion Load (0.3ms)[0m  [1m[34mSELECT `questions`.* FROM `questions` WHERE `questions`.`content` = '「麟」の字の花押(自署の代わりに用いられる記号もしくは符合)を使っていたとされる武将は次のうち誰か。' LIMIT 1[0m
  [1m[36mTRANSACTION (0.1ms)[0m  [1m[35mBEGIN[0m
  [1m[36mQuestion Create (1.1ms)[0m  [1m[32mINSERT INTO `questions` (`content`, `explanation`, `created_at`, `updated_at`) VALUES ('「麟」の字の花押(自署の代わりに用いられる記号もしくは符合)を使っていたとされる武将は次のうち誰か。', 'この花押は中国由来の伝説上の生物である「麒麟」を意味するとされるが、麒麟は正しい政治が行われている世にしか現れない生物であると中世日本でも信じられていた。', '2025-09-04 05:17:33.413171', '2025-09-04 05:17:33.413171')[0m
