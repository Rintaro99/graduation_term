  [1m[36mTRANSACTION (0.1ms)[0m  [1m[35mBEGIN[0m
  [1m[36mQuestion Create (1.4ms)[0m  [1m[32mINSERT INTO `questions` (`content`, `explanation`, `created_at`, `updated_at`) VALUES ('幼名では通称「麟太郎」という名前で呼ばれていた歴史上の人物は次のうち誰か', '幼名および通称は麟太郎（りんたろう）。諱は義邦（よしくに）。明治維新後は安芳（やすよし）と改名。海舟は号で、佐久間象山直筆の書「海舟書屋」からとったもの。', '2025-06-18 06:23:49.310008', '2025-06-18 06:23:49.310008')[0m
  [1m[36mTRANSACTION (0.5ms)[0m  [1m[35mCOMMIT[0m
