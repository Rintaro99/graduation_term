{
  "public": "frontend/dist",
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build" }
  ],
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://how-to-write-rin.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
