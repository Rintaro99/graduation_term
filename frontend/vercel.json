{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://how-to-write-rin.onrender.com/api/$1"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"],
      "dest": "https://how-to-write-rin.onrender.com/api/$1"
    }
  ]
}
