<section class="top_page">
    <div class="container">
        <div class="top_page_content_img">
            <%= image_tag "top_page_logo.jpg", alt: "トップページロゴ"%>
        </div>
        <div class="top_page_content_buttun">
            <%= link_to "新規登録", signup_path, class: "btn top_page_content_buttun_signup" %>
            <%= link_to "ログイン",  login_path,  class: "btn top_page_content_buttun_login"  %>
        </div>

        <% content_for :og_title, "りんってかける？" %>
        <% content_for :og_description, "あなたはこの字をどれだけ知っている？SNSログインですぐに始められます。" %>
        <% content_for :og_image, image_url("top_page_logo.jpg") %>
    </div>
</section>